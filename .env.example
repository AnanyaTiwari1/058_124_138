# Groq LLM API Configuration (Llama 3.3 / Mixtral for high-speed document chat & reasoning)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=document_intelligence_db
COLLECTION_NAME=documents

# Application Settings
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# OCR Engine (pytesseract, easyocr, or mock fallback)
OCR_ENGINE=auto

# Embeddings & Pretrained Models
BERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu
